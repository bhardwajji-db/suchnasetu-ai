# SuchnaSetu AI Configuration

# -------------------------------------------------------------
# LLM Provider Configuration
# Supported providers: ollama (default local), openrouter, gemini, huggingface
# -------------------------------------------------------------
LLM_PROVIDER=ollama

# Generic fallback API key (if provider-specific key is not set)
LLM_API_KEY=

# Local Ollama Configuration (Default - 100% offline & air-gapped)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT_SECONDS=120

# OpenRouter Configuration (Cloud Provider - optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-2-9b-it:free

# Google Gemini Configuration (Cloud Provider - optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Hugging Face Inference API Configuration (Cloud Provider - optional)
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=google/gemma-2-9b-it

# -------------------------------------------------------------
# OCR Engine Configuration
# Supported engines: tesseract (default), rapidocr
# -------------------------------------------------------------
OCR_ENGINE=tesseract

# Windows default path for Tesseract OCR:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Optional custom tessdata path if extra language packs are stored locally:
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# -------------------------------------------------------------
# Ingestion, Security & Session Storage
# -------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_DIMENSION=4096
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp,txt
SESSION_STORAGE_DIR=.sessions
SESSION_TTL_HOURS=24
