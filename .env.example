# Notice2Action AI Configuration

# Ollama Endpoint & Model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT_SECONDS=60

# OCR Engine Configuration
# Windows default path for Tesseract OCR:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Optional custom tessdata path if extra language packs are stored locally:
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# Ingestion & Security Limits
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_DIMENSION=4096
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,txt
