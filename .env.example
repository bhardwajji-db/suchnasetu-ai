# =====================================================================
# SuchnaSetu AI — Environment Configuration Template (.env.example)
# =====================================================================
# Copy this file to '.env' and customize for your environment.
# All values here are placeholders or safe development defaults.
# DO NOT COMMIT LIVE API KEYS OR PRODUCTION SECRETS TO VERSION CONTROL.
# =====================================================================

# ---------------------------------------------------------------------
# Environment & Host Configuration
# ---------------------------------------------------------------------
# Mode: "development", "production", or "test"
APP_ENV=development

# Network Host Binding:
# 127.0.0.1 = Safe local development (only accessible from this machine)
# 0.0.0.0   = Exposes to LAN / Wi-Fi (use only with reverse proxy or on trusted private networks)
HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------
# LLM Provider Configuration
# Supported providers: ollama (default local), huggingface, openrouter, gemini
# AI_PROVIDER or LLM_PROVIDER selects the active inference engine.
# ---------------------------------------------------------------------
AI_PROVIDER=ollama
LLM_PROVIDER=ollama

# Generic fallback API key (if provider-specific key is not set)
LLM_API_KEY=

# Local Ollama Configuration (Default - 100% offline & air-gapped)
# Ollama must run locally on the machine. Never bind Ollama to 0.0.0.0 or expose to public internet.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=5m

# Cloud Provider 1: Hugging Face Inference Providers API (Hosted Gemma 4)
# Obtain a User Access Token from Hugging Face (https://huggingface.co/settings/tokens)
# Set HF_TOKEN in your environment or below. DO NOT COMMIT REAL TOKENS TO GIT.
HF_TOKEN=
HF_MODEL_ID=google/gemma-4-26B-A4B
HF_PROVIDER=auto
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=google/gemma-4-26B-A4B

# Cloud Provider 2: Google Gemini (Recommended for public cloud deployment)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Cloud Provider 3: OpenRouter (Cloud multi-model router)
# Obtain an API key from OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------
# OCR Engine Configuration
# Supported engines: tesseract (default), rapidocr
# ---------------------------------------------------------------------
OCR_ENGINE=tesseract

# Windows default installation path for Tesseract OCR:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional custom tessdata path if extra language packs are stored locally:
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# ---------------------------------------------------------------------
# Security, CORS & Authentication
# ---------------------------------------------------------------------
# Secret key used for HMAC-SHA256 digests of session tokens and OTP codes.
# In production, generate a cryptographically strong 64-character secret.
# E.g.: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=suchnasetu-dev-insecure-secret-key-change-in-production

# Cookie Security:
# Set to 'true' in production behind HTTPS. When false, cookies are accepted over plain HTTP (localhost).
# Automatically resolves to true if request is HTTPS or has X-Forwarded-Proto: https.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Authorized Origins for CORS (comma-separated):
# Must list exact frontend origins allowed to send credentials and read API responses.
# Wildcards are rejected when credentials are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_PAGES_DEV=true
CORS_ORIGIN_REGEX=

# Public URL of the frontend application:
AUTH_PUBLIC_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------
# Storage & Database
# ---------------------------------------------------------------------
DATABASE_PATH=data/suchnasetu.db
UPLOADS_DIR=data/uploads

# Expiration Settings:
AUTH_VERIFY_EXPIRE_HOURS=24
AUTH_TOKEN_EXPIRE_MINUTES=15
GUEST_RATE_LIMIT_PER_WINDOW=10

# ---------------------------------------------------------------------
# Ingestion Bounds & Limits
# ---------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_DIMENSION=4096
MAX_PDF_PAGES=30
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp,txt,docx,tif,tiff
SESSION_STORAGE_DIR=.sessions
SESSION_TTL_HOURS=24

# ---------------------------------------------------------------------
# Email Delivery Service Configuration
# Supported backends:
# - 'console' (default): Development mode — logs OTPs safely to console (zero external transmission)
# - 'smtp'   : Production mode — connects via STARTTLS to configured mail server
# ---------------------------------------------------------------------
AUTH_EMAIL_BACKEND=console
SMTP_HOST=smtp.example.gov.in
SMTP_PORT=587
SMTP_USERNAME=notifications@suchnasetu.gov.in
SMTP_PASSWORD=your_secure_smtp_password_here
SMTP_USE_TLS=true
SMTP_FROM_EMAIL="SuchnaSetu AI <notifications@suchnasetu.gov.in>"
