# ==============================================================================
# SochnaSetu AI — Production Environment Variables (.env.production)
# ==============================================================================

APP_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Local-first Ollama LLM
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT_SECONDS=120

# OCR Engine
OCR_ENGINE=tesseract
TESSERACT_CMD=/usr/bin/tesseract
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# Ingestion & Security
MAX_UPLOAD_SIZE_MB=15
MAX_IMAGE_DIMENSION=4096
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp,txt,docx,tif,tiff
SESSION_STORAGE_DIR=.sessions
SESSION_TTL_HOURS=24
DATABASE_PATH=data/suchnasetu.db
