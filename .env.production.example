# ==============================================================================
# SochnaSetu AI — Production Environment Variables (.env.production)
# ==============================================================================

APP_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# AI Provider (OpenRouter Cloud or Ollama Local)
# ------------------------------------------------------------------------------
# For cloud deployment on Render, use: AI_PROVIDER=openrouter
AI_PROVIDER=openrouter
LLM_PROVIDER=openrouter

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_TIMEOUT_SECONDS=60

# Optional Local Ollama (if running on a dedicated GPU host)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------------------
# OCR Engine Configuration
# ------------------------------------------------------------------------------
OCR_ENGINE=tesseract
TESSERACT_CMD=/usr/bin/tesseract
TESSDATA_PREFIX=/app/assets/tessdata

# ------------------------------------------------------------------------------
# Persistent Storage & Database
# ------------------------------------------------------------------------------
# Mounted volume on Render Disk (/app/data)
DATABASE_PATH=/app/data/suchnasetu.db
UPLOADS_DIR=/app/data/uploads
SESSION_STORAGE_DIR=/app/data/.sessions
SESSION_TTL_HOURS=24

# ------------------------------------------------------------------------------
# Security, CORS & Authentication
# ------------------------------------------------------------------------------
# Must be set to a cryptographically strong 64-char key in production
AUTH_SECRET_KEY=change-this-to-a-secure-random-64-character-secret-in-production
AUTH_COOKIE_SECURE=true
# Set to 'none' for cross-site cookie handling between *.pages.dev and *.onrender.com
AUTH_COOKIE_SAMESITE=none

# Authorized Frontend Origins (Cloudflare Pages production and preview domains)
CORS_ALLOWED_ORIGINS=https://sochnasetu-ai.pages.dev
CORS_ALLOW_PAGES_DEV=true
AUTH_PUBLIC_APP_URL=https://sochnasetu-ai.pages.dev

# Limits
MAX_UPLOAD_SIZE_MB=15
MAX_IMAGE_DIMENSION=4096
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp,txt,docx,tif,tiff
GUEST_RATE_LIMIT_PER_WINDOW=10
