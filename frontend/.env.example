# ==============================================================================
# SochnaSetu AI — Frontend Environment Variables Template
# ==============================================================================
# In local development:
# Leave VITE_API_BASE_URL empty to use Vite's automatic /api proxy to http://127.0.0.1:8000
#
# In production on Cloudflare Pages:
# Set VITE_API_BASE_URL to your deployed Render backend URL (e.g., https://sochnasetu-api.onrender.com)
#
# DO NOT ADD SENSITIVE API KEYS OR SECRETS TO THIS FILE.
# All VITE_* variables are embedded in public client bundles.
# ==============================================================================

VITE_API_BASE_URL=
